generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceStatus {
  PENDING // รอการตอบรับ
  ACCEPTED // วินรับงานแล้ว กำลังไปจุดรับ
  IN_PROGRESS // กำลังให้บริการ (รับผู้โดยสารแล้ว)
  COMPLETED // ให้บริการเสร็จสิ้น
  CANCELLED // ยกเลิก
}

enum DriverVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  PROMPTPAY // ผู้โดยสารโอนตาม QR พร้อมเพย์และระบบตรวจสลิปแล้ว
}

enum PaymentStatus {
  PENDING // ยังไม่ถึงขั้นตอนชำระเงิน
  PAID // คนขับยืนยันว่าได้รับเงินแล้ว
  DISPUTED // คนขับแจ้งว่ายังไม่ได้รับเงิน / มีข้อพิพาท
}

enum NotificationRecipient {
  USER
  DRIVER
}

enum SosStatus {
  OPEN
  RESOLVED
}

enum AdminRole {
  SUPER_ADMIN // ดูแลทั้งแพลตฟอร์ม: สร้างพื้นที่ สร้างแอดมินของแต่ละพื้นที่ เห็นข้อมูลทุกพื้นที่
  AREA_ADMIN // แอดมินของพื้นที่เดียว (เช่น วินในมหาวิทยาลัยอื่น) เห็น/จัดการเฉพาะพื้นที่ของตัวเอง
}

enum ExpenseCategory {
  FUEL // เติมน้ำมัน (ใส่จำนวนลิตร + เลขไมล์ได้ เพื่อคำนวณอัตราสิ้นเปลืองจริง)
  TIRE // เปลี่ยนยาง
  ENGINE_OIL // เปลี่ยนน้ำมันเครื่อง
  MAINTENANCE // บำรุงรักษาตามระยะ
  REPAIR // ซ่อม
  OTHER
}

// พื้นที่ให้บริการ (tenant) — แต่ละที่ (เช่น มก. กำแพงแสน, มหาวิทยาลัยอื่น) ตั้งค่าของตัวเองได้ คนขับ/คิว/สถานที่/คำขอ
// แยกตามพื้นที่ ส่วนบัญชีผู้โดยสารใช้ได้ทุกพื้นที่ (แอปเลือกพื้นที่จาก GPS ตอนเรียกวิน)
model Area {
  id          String  @id @default(uuid())
  slug        String  @unique // ใช้อ้างอิงแบบอ่านง่าย เช่น "ku-kps"
  name        String // ชื่อเต็มของพื้นที่ เช่น "มหาวิทยาลัยเกษตรศาสตร์ วิทยาเขตกำแพงแสน"
  displayName String // ชื่อที่โชว์ในแอป เช่น "มก. กำแพงแสน"
  logoUrl     String?

  centerLat       Float
  centerLng       Float
  flatRadiusKm    Float @default(2) // ต้นทางและปลายทางอยู่ในรัศมีนี้ทั้งคู่ = เหมาจ่าย flatFare
  serviceRadiusKm Float @default(15) // รับผู้โดยสารได้ไกลจากจุดกลางสุดเท่านี้ (ใช้เลือกพื้นที่จากตำแหน่งจุดรับ)

  flatFare   Float @default(20)
  ratePerKm  Float @default(10) // นอกเขตเหมาจ่าย คิดตามระยะถนนจริง
  minFare    Float @default(20)

  emergencyContacts Json @default("[]") // [{ label, phone }] — โชว์ในแผง SOS และหน้าตั้งค่าของพื้นที่นี้

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivers   Driver[]
  requests  ServiceRequest[]
  landmarks Landmark[]
  admins    Admin[]
  sosAlerts SosAlert[]

  @@map("areas")
}

model User {
  id           String  @id @default(uuid())
  fullName     String
  phone        String  @unique
  email        String  @unique // ล็อกอินด้วยอีเมลนี้ (อีเมลไหนก็ได้ เก็บเป็นตัวพิมพ์เล็กเสมอ — ดู normalizeEmail)
  passwordHash String
  studentId    String?
  fcmToken     String?

  // รีเซ็ตรหัสผ่าน: resetToken เก็บ sha256 ของรหัส 6 หลักที่ส่งทางอีเมล (ไม่เก็บรหัสจริง) — ไม่ unique เพราะ
  // รหัส 6 หลักของสองคนชนกันได้; resetAttempts นับครั้งที่กรอกผิด ครบโควตาแล้วรหัสนั้นใช้ไม่ได้ (กันสุ่มเดา)
  resetToken          String?
  resetTokenExpiresAt DateTime?
  resetAttempts       Int       @default(0)

  // ระงับบัญชีโดย admin: login/เรียก API/ต่อ socket ไม่ได้จนกว่าจะปลดระงับ (ดู middlewares/auth.js)
  isSuspended     Boolean   @default(false)
  suspendedReason String?
  suspendedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requests     ServiceRequest[]
  ratingsGiven Rating[]

  @@map("users")
}

model Driver {
  id                 String                   @id @default(uuid())
  fullName           String
  phone              String                   @unique
  passwordHash       String
  areaId             String // คนขับสังกัดพื้นที่เดียว คิวรับงานแยกตามพื้นที่
  area               Area                     @relation(fields: [areaId], references: [id])
  vinNumber          String // หมายเลขวิน — ไม่ซ้ำภายในพื้นที่เดียวกัน (แต่ละพื้นที่มีวินเบอร์ 1, 2, 3 ของตัวเอง)
  licensePlate       String
  vehicleModel       String?
  promptPayId        String? // เบอร์โทร (10 หลัก) หรือเลขบัตร ปชช. (13 หลัก) ที่ผูกกับพร้อมเพย์ — ใช้สร้าง QR รับเงิน
  verificationStatus DriverVerificationStatus @default(PENDING)
  rejectionReason    String? // เหตุผลเมื่อ verificationStatus = REJECTED

  // เอกสารยืนยันตัวตน (เก็บเป็น URL ไปยังไฟล์ที่อัปโหลด)
  photoUrl             String? // รูปถ่ายหน้าตรง
  idCardPhotoUrl       String? // รูปบัตรประชาชน
  driverLicensePhotoUrl String? // รูปใบขับขี่ (คนละใบกับบัตรประชาชน)
  vehiclePhotoUrl      String? // รูปรถเต็มคัน
  platePhotoUrl        String? // รูปป้ายทะเบียน

  // ระงับบัญชีโดย admin: login/เรียก API/ต่อ socket ไม่ได้จนกว่าจะปลดระงับ (ดู middlewares/auth.js)
  isSuspended     Boolean   @default(false)
  suspendedReason String?
  suspendedAt     DateTime?

  // ---- สถานะคิวรับงาน (FIFO) ----
  // isOnline      : คนขับกดออนไลน์อยู่ (คิวประกอบด้วยเฉพาะคนที่ isOnline = true)
  // isAvailable   : ว่างรับงาน — false เมื่อกำลังอยู่ระหว่างทริป (ออนไลน์อยู่แต่ไม่ถูกเสนองาน)
  // queueJoinedAt : เวลาเข้าคิว ใช้ ORDER BY หาหัวคิว (null = ไม่อยู่ในคิว) — Timestamptz(6) ละเอียดระดับ microsecond
  //                 เพื่อแทรกคิวระหว่างสองคนได้ (light penalty ตอน timeout) โดยไม่ต้องขยับคนอื่น
  // timeoutCount  : จำนวนครั้งที่ปล่อยงานให้หมดเวลาติดต่อกัน (รีเซ็ตเมื่อรับงาน/จบทริป/ออนไลน์ใหม่)
  isOnline      Boolean   @default(false)
  isAvailable   Boolean   @default(true)
  queueJoinedAt DateTime? @db.Timestamptz(6)
  timeoutCount  Int       @default(0)

  currentLat  Float?
  currentLng  Float?
  fcmToken    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ต้นทุนรถของคนขับ — ใช้ประมาณค่าน้ำมันต่อเที่ยว (ระยะทาง / กม.ต่อลิตร × ราคาต่อลิตร)
  fuelKmPerLiter    Float?
  fuelPricePerLiter Float?

  requests              ServiceRequest[]
  passengerRatingsGiven DriverRating[]
  expenses              DriverExpense[]

  @@unique([areaId, vinNumber])
  @@index([areaId, isOnline, isAvailable, queueJoinedAt])
  @@map("drivers")
}

// รายจ่ายของคนขับที่จดเอง (เติมน้ำมัน เปลี่ยนยาง ซ่อม ฯลฯ) — ใช้คำนวณกำไรและอัตราสิ้นเปลืองน้ำมันจริง
model DriverExpense {
  id         String          @id @default(uuid())
  driverId   String
  driver     Driver          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  category   ExpenseCategory
  amount     Float // บาท
  occurredAt DateTime // วันที่จ่ายจริง (ย้อนหลังได้)
  note       String?
  liters     Float? // เฉพาะ FUEL
  odometerKm Float? // เลขไมล์ตอนเติม — เติมเต็มถังติดกัน 2 ครั้งพอคำนวณ กม./ลิตร จริงได้
  createdAt  DateTime        @default(now())

  @@index([driverId, occurredAt])
  @@map("driver_expenses")
}

model Admin {
  id           String    @id @default(uuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(AREA_ADMIN)
  areaId       String? // null สำหรับ SUPER_ADMIN
  area         Area?     @relation(fields: [areaId], references: [id])
  createdAt    DateTime  @default(now())

  @@map("admins")
}

model ServiceRequest {
  id     String        @id @default(uuid())
  status ServiceStatus @default(PENDING)

  areaId String // พื้นที่ที่ให้บริการทริปนี้ (เลือกจากจุดรับ) — เสนองานให้เฉพาะคนขับในคิวของพื้นที่นี้
  area   Area   @relation(fields: [areaId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  driverId String?
  driver   Driver? @relation(fields: [driverId], references: [id])

  pickupLat     Float
  pickupLng     Float
  pickupAddress String?

  destinationLat     Float
  destinationLng     Float
  destinationAddress String?

  isWithinCampus Boolean @default(true) // อยู่ในเขตเหมาจ่ายของพื้นที่ (Area.flatRadiusKm) ทั้งต้นทางและปลายทาง
  distanceKm     Float? // ระยะทางถนนจริง ใช้คิดค่าโดยสารนอกเขตเหมาจ่าย และประมาณค่าน้ำมันของคนขับ
  fare           Float? // คำนวณตามอัตราของพื้นที่ (Area.flatFare / ratePerKm / minFare)

  paymentMethod PaymentMethod @default(CASH)
  paymentStatus PaymentStatus @default(PENDING)
  disputeNote   String? // เหตุผลเมื่อ paymentStatus = DISPUTED
  // ตรวจสลิปโอนเงิน (ดู services/payment.service.js) — ไม่เก็บรูปสลิป เก็บแค่เลขอ้างอิงธุรกรรมไว้กันสลิปซ้ำ
  paymentRef          String?   @unique // เลขอ้างอิงธุรกรรมบนสลิป (unique = สลิปใบเดียวใช้ได้ทริปเดียว)
  paymentVerifiedAt   DateTime? // เวลาที่ตรวจสลิปผ่าน
  paymentConfirmedBy  String? // ใครยืนยันว่าจ่ายแล้ว: SLIP | DRIVER | ADMIN
  paymentSlipAttempts Int       @default(0) // จำนวนครั้งที่ผู้โดยสารส่งสลิปแล้วไม่ผ่าน (จำกัดตาม SLIP_MAX_ATTEMPTS)
  paymentSlipError    String? // เหตุผลที่สลิปล่าสุดไม่ผ่าน (ให้ admin ดูตอนมีข้อพิพาท)

  requestedAt  DateTime  @default(now())
  acceptedAt   DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String? // เช่น "ไม่พบคนขับว่างในขณะนี้" (ระบบยกเลิกอัตโนมัติ), หรือเหตุผลที่ user/driver ยกเลิกเอง

  // สถานะคิวรับงานแบบเสนอทีละคน (sequential offer): ตอนนี้กำลังเสนองานให้คนขับคนไหนอยู่ และหมดเวลาเมื่อไหร่
  // (60 วิ/คน) ถ้าไม่ตอบสนองภายในเวลา background sweep job จะเลื่อนไปเสนอคนถัดไปในคิวอัตโนมัติ
  offeredDriverId String?
  offerExpiresAt  DateTime?
  // เบอร์คนขับที่ถูกเสนองานนี้ไปแล้ว (ปฏิเสธ/หมดเวลา) กันไม่ให้วนกลับมาเสนอซ้ำในคำขอเดียวกัน
  triedDriverIds  String[]  @default([])
  // คนขับที่ปล่อยงานนี้ให้หมดเวลา (timeout ครั้งที่ 1-2 = light penalty) — รอจนรู้ว่าใครได้งานรอบนี้ ค่อยย้ายไป
  // "ต่อจากคนที่ได้งาน" ตอนมีคนกดรับ (ดู queue.service.js) เพราะตอน timeout ยังไม่รู้ว่าใครจะได้งาน
  timedOutDriverIds String[] @default([])

  rating       Rating?
  driverRating DriverRating?

  @@index([areaId, status])
  @@map("service_requests")
}

model Rating {
  id               String         @id @default(uuid())
  serviceRequestId String         @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  ratedByUserId String
  ratedByUser   User   @relation(fields: [ratedByUserId], references: [id])

  score     Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@map("ratings")
}

// คนขับให้คะแนนผู้โดยสาร — ฝั่งตรงข้ามของ Rating (เพื่อความรับผิดชอบร่วมกันทั้งสองฝ่าย)
model DriverRating {
  id               String         @id @default(uuid())
  serviceRequestId String         @unique
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])

  ratedByDriverId String
  ratedByDriver   Driver @relation(fields: [ratedByDriverId], references: [id])

  score     Int // 1-5
  comment   String?
  createdAt DateTime @default(now())

  @@map("driver_ratings")
}

// สถานที่ในพื้นที่ให้บริการสำหรับหน้าค้นหาจุดหมาย / จุดหมายยอดนิยม (แต่ละพื้นที่มีชุดของตัวเอง)
model Landmark {
  id        String   @id @default(uuid())
  areaId    String
  area      Area     @relation(fields: [areaId], references: [id])
  name      String
  detail    String?
  lat       Float
  lng       Float
  isPopular Boolean  @default(false)
  // true = admin ตรวจ/ปักหมุดพิกัดให้ตรงกับสถานที่จริงแล้ว, false = ยังเป็นค่าประมาณ (ดูหน้า "จัดการสถานที่" ใน admin)
  coordsVerified Boolean @default(false)
  createdAt DateTime @default(now())

  @@index([areaId])
  @@map("landmarks")
}

model Notification {
  id            String                @id @default(uuid())
  recipientType NotificationRecipient
  recipientId   String // userId หรือ driverId ตาม recipientType (ไม่ผูก FK ตรง เพราะอ้างได้ 2 ตาราง)
  title         String
  body          String
  isRead        Boolean               @default(false)
  createdAt     DateTime              @default(now())

  @@index([recipientType, recipientId])
  @@map("notifications")
}

// การแจ้งเหตุฉุกเฉิน (กดปุ่ม SOS) จาก user หรือ driver — admin เห็นแบบ real-time ผ่าน socket room "admin"
model SosAlert {
  id        String                @id @default(uuid())
  actorType NotificationRecipient // USER หรือ DRIVER ที่กดปุ่ม SOS
  actorId   String                // userId หรือ driverId ตาม actorType (ไม่ผูก FK ตรง เพราะอ้างได้ 2 ตาราง เหมือน Notification)

  lat  Float?
  lng  Float?
  note String?

  serviceRequestId String? // ทริปที่กำลังดำเนินอยู่ตอนกด SOS ถ้ามี (ไม่ผูก FK เพื่อความง่าย)

  // พื้นที่ที่แอดมินต้องเห็นเหตุนี้: จากทริป > พื้นที่ของคนขับ > พื้นที่ที่ใกล้พิกัดที่สุด (null = เห็นแค่ super admin)
  areaId String?
  area   Area?   @relation(fields: [areaId], references: [id])

  // เบอร์ฉุกเฉินที่ผู้แจ้งกดโทรออกจากหน้า SOS (เช่น "1669" หน่วยแพทย์ฉุกเฉิน, "191" ตำรวจ) — เก็บไว้เพื่อให้ admin
  // เห็นว่ามีการประสานงานหน่วยงานภายนอกไปแล้วหรือยัง ไม่ใช่การโทรออกอัตโนมัติจากระบบ (ทำไม่ได้ในเว็บแอป/เพื่อความปลอดภัย)
  contactedEmergencyNumber String?

  status       SosStatus @default(OPEN)
  resolvedNote String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([actorType, actorId])
  @@map("sos_alerts")
}
