PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/kuvin?schema=public"
JWT_SECRET=change_me
JWT_EXPIRES_IN=7d
# ตั้งค่าอย่างใดอย่างหนึ่งพอ (ไม่ตั้งเลย = push notification จะ log-only แทนการส่งจริง)
# ตัวเลือก 1: วาง service account JSON ทั้งก้อนเป็น string บรรทัดเดียว (เหมาะกับ deploy บน Railway/Render)
FIREBASE_SERVICE_ACCOUNT_JSON=
# ตัวเลือก 2: ชี้ path ไปยังไฟล์ service-account.json (เหมาะกับรันบนเครื่อง local)
GOOGLE_APPLICATION_CREDENTIALS=

# เส้นทาง/ระยะทางถนนจริง (ใช้คำนวณค่าโดยสารและวาดแผนที่) — ไม่ตั้ง = ใช้ demo server สาธารณะ https://router.project-osrm.org
# (เหมาะกับพัฒนา/ทดสอบเท่านั้น) ใช้งานจริงควรรัน OSRM เองแล้วตั้งค่า เช่น http://localhost:5000
# OSRM_BASE_URL=http://localhost:5000

# ตรวจสลิปโอนเงินพร้อมเพย์อัตโนมัติ (ดู apps/api/README.md หัวข้อ "ชำระเงินและตรวจสลิป")
#   slipok = SlipOK จริง (ต้องมีบัญชี + ตั้งสองค่าถัดไป)   mock = ตัวจำลองสำหรับ dev (รับสลิปอะไรก็ได้ ห้ามใช้ production)
#   off    = ปิด (คนขับกดยืนยันการรับเงินเอง)             ไม่ตั้ง = dev ใช้ mock / production ใช้ off
SLIP_PROVIDER=
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
# ผู้โดยสารส่งสลิปที่ไม่ผ่านได้กี่ครั้งต่อทริป (กันยิง API ที่คิดเงินต่อสลิปซ้ำ ๆ)
SLIP_MAX_ATTEMPTS=5
