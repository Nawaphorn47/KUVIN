# คัดลอกเป็น .env ก่อนใช้งาน:  cp .env.example .env     (ห้าม commit .env — .gitignore กันไว้แล้ว)
# บน VPS ไม่ต้องคัดลอกไฟล์นี้ — ใช้ deploy/make-env.sh สร้าง .env ที่สุ่มความลับให้เอง

# ---------- PostgreSQL ----------
POSTGRES_USER=kuvin
POSTGRES_PASSWORD=kuvin_local_only
POSTGRES_DB=kuvin
# host = db คือชื่อ service ใน docker-compose.yml
DATABASE_URL=postgresql://kuvin:kuvin_local_only@db:5432/kuvin?schema=public
DB_PORT=5533

# ---------- port บนเครื่อง host (VPS: bind 127.0.0.1 แล้วให้ Nginx ส่งต่อ) ----------
API_BIND=127.0.0.1:3301
WEB_BIND=127.0.0.1:3302
ADMIN_BIND=127.0.0.1:3303

# ---------- ชื่อ image (VPS: image จาก GHCR เช่น ghcr.io/<user>/<repo>-api:latest) ----------
API_IMAGE=kuvin-api:local
WEB_IMAGE=kuvin-web:local
ADMIN_IMAGE=kuvin-admin:local

# ---------- ฝังตอน build เว็บ (docker compose build ในเครื่องเท่านั้น — บน VPS ใช้ image ที่ CI build แล้ว) ----------
VITE_API_URL=http://localhost:3301/api
VITE_PUBLIC_APP_URL=http://localhost:3302

# ---------- API (ดูคำอธิบายทั้งหมดใน apps/api/.env.example และ docs/CI_CD.md) ----------
# production: JWT_SECRET ต้องยาว ≥ 32 ตัวอักษร ไม่งั้น API ไม่ยอมเริ่ม
JWT_SECRET=local-only-change-me-local-only-change-me
CORS_ORIGINS=http://localhost:3302,http://localhost:3303
# test = แอปโชว์รหัส OTP แทน SMS (ยังไม่ได้ซื้อ SMS) / OTP_TEST_PHONES = เบอร์ที่ใช้ได้ (* = ทุกเบอร์ เฉพาะเครื่อง dev)
OTP_MODE=test
OTP_TEST_PHONES=*
# บัญชีแอดมินคนแรก (รหัสผ่าน ≥ 12 ตัว) — ล็อกอินได้แล้วลบ SEED_ADMIN_PASSWORD ออกจาก .env
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-local-12345
# off = ปิดตรวจสลิปอัตโนมัติ (คนขับกดยืนยันรับเงินเอง) — easyslip ต้องตั้ง EASYSLIP_API_KEY; mock ใช้ใน production ไม่ได้
SLIP_PROVIDER=off
