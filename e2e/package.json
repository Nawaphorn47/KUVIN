{
  "name": "kuvin-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "ทดสอบแอป KU VIN ปลายทางถึงปลายทาง (Playwright) — ไม่อยู่ใน npm workspaces ของ repo เพื่อไม่ให้กระทบ lockfile ที่ Docker ใช้",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "report:docs": "node scripts/make-report.js",
    "test:all": "playwright test && node scripts/make-report.js"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1"
  }
}
